{
  "rules": {
    "rooms": {
      "$room_id": {
        ".read": "auth != null && root.child('rooms').child($room_id).child('members').child(auth.uid).exists()",
        ".write": false,
        "members": {
          ".read": "auth != null && root.child('rooms').child($room_id).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": false,
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "sessions": {
      "$room_id": {
        ".read": "auth != null && data.child('users').child(auth.uid).exists()",
        ".write": false
      }
    },
    "messages": {
      "$room_id": {
        ".read": "auth != null && root.child('sessions').child($room_id).child('users').child(auth.uid).exists()",
        ".write": false,
        "$messageId": {
          ".write": "!data.exists() && auth != null && root.child('sessions').child($room_id).child('users').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['senderId', 'text', 'timestamp']) && newData.child('senderId').val() == auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000 && newData.child('timestamp').isNumber()"
        }
      }
    },
    "typing": {
      "$room_id": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['isTyping', 'displayName']) && newData.child('isTyping').isBoolean() && newData.child('displayName').isString() && newData.child('displayName').val().length <= 100"
        }
      }
    },
    "nameQueue": {
      "$room_id": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "pool_presence": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.isBoolean()"
      }
    },
    "presence": {
      "$room_id": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 30)"
        }
      }
    }
  }
}
