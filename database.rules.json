{
  "rules": {
    "rooms": {
      "$room_id": {
        ".read": "auth != null && root.child('rooms').child($room_id).child('members').child(auth.uid).exists()",
        ".write": false,
        "members": {
          ".read": "auth != null && root.child('rooms').child($room_id).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && !newData.exists()",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "typing": {
      "$room_id": {
        ".read": "auth != null && root.child('rooms').child($room_id).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['isTyping', 'displayName'])",
          "isTyping": { ".validate": "newData.isBoolean()" },
          "displayName": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "photoUrl": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
          "$other": { ".validate": false }
        }
      }
    },
    "nameQueue": {
      "$room_id": {
        ".read": "auth != null && root.child('rooms').child($room_id).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('rooms').child($room_id).child('members').child(auth.uid).exists()"
      }
    },
    "friends": {
      "$ownerUid": {
        "$friendUid": {
          ".read": "auth != null && auth.uid == $ownerUid",
          ".write": "auth != null && auth.uid == $ownerUid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "user_status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['status'])",
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'online' || newData.val() == 'in_room')"
        },
        "roomId": {
          ".validate": "newData.isString() && newData.val().length == 5"
        },
        "roomMode": {
          ".validate": "newData.isString() && (newData.val() == '1v1' || newData.val() == 'group')"
        },
        "maxUsers": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 5"
        },
        "memberCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "isLocked": {
          ".validate": "newData.isBoolean()"
        },
        "backgroundTheme": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pool_presence": {
      ".read": "auth != null && auth.token.email != null && auth.token.email.endsWith('@cozytalk.com')",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('friends').child(auth.uid).child($uid).exists())",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.isBoolean()"
      }
    },
    "presence": {
      "$room_id": {
        ".read": "auth != null && root.child('rooms').child($room_id).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 30)"
        }
      }
    },
    "friend_typing": {
      "$friendship_id": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "!newData.exists() || newData.isBoolean()"
        }
      }
    },
    "jukebox": {
      "$room_id": {
        ".read":  "auth != null && (root.child('rooms').child($room_id).child('members').child(auth.uid).exists() || root.child('presence').child($room_id).child(auth.uid).exists())",
        ".write": "auth != null && (root.child('rooms').child($room_id).child('members').child(auth.uid).exists() || root.child('presence').child($room_id).child(auth.uid).exists())"
      }
    },
    "card_shuffle": {
      "$room_id": {
        ".read":  "auth != null && (root.child('rooms').child($room_id).child('members').child(auth.uid).exists() || root.child('presence').child($room_id).child(auth.uid).exists())",
        ".write": "auth != null && (root.child('rooms').child($room_id).child('members').child(auth.uid).exists() || root.child('presence').child($room_id).child(auth.uid).exists())",
        ".validate": "!newData.exists() || newData.hasChildren(['shufflerUid', 'shufflerName', 'questionId', 'questionText', 'questionCategory', 'questionDepth', 'timestamp'])",
        "shufflerName":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "shufflerUid":      { ".validate": "newData.isString() && newData.val().length > 0" },
        "questionId":       { ".validate": "newData.isString()" },
        "questionText":     { ".validate": "newData.isString() && newData.val().length <= 500" },
        "questionCategory": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "questionDepth":    { ".validate": "newData.isString()" },
        "timestamp":        { ".validate": "newData.isNumber()" },
        "$other":           { ".validate": false }
      }
    }
  }
}
