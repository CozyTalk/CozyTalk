rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function _isCozytalkEmail() {
      return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.lower().matches('.*@cozytalk\\.com');
    }

    // Report context images — any signed-in user may upload evidence; only
    // admins (@cozytalk.com) may read for moderation.
    match /reports/{document=**} {
      allow create: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read: if _isCozytalkEmail();
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
