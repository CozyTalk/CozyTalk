{
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(flutter test *)",
      "Bash(flutter analyze *)",
      "Bash(npx tsc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd); exec \"$root/.claude/hooks/enforce-pr-template.sh\"'"
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) && rm -f \"$root/.git/index.lock\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
