{
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(flutter test *)",
      "Bash(flutter analyze *)",
      "Bash(npx tsc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/enforce-pr-template.sh"
          }
        ]
      }
    ]
  }
}
