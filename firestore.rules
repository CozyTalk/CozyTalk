rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Checks rooms/{sessionId} (new matchmaking system)
    function _isRoomsParticipant(sessionId) {
      return exists(/databases/$(database)/documents/rooms/$(sessionId))
        && request.auth.uid in
           get(/databases/$(database)/documents/rooms/$(sessionId)).data.users;
    }

    // Checks active_sessions/{sessionId} (proto-session backward compat)
    function _isActiveSessionParticipant(sessionId) {
      return exists(/databases/$(database)/documents/active_sessions/$(sessionId))
        && request.auth.uid in
           get(/databases/$(database)/documents/active_sessions/$(sessionId)).data.users;
    }

    function isChatRoomParticipant(sessionId) {
      return isSignedIn()
        && (_isRoomsParticipant(sessionId) || _isActiveSessionParticipant(sessionId));
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId);

      // role and uid are immutable after creation — only Cloud Functions set role
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user';

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['role', 'uid']);
    }

    // ── waiting_pool ─────────────────────────────────────────────────────────
    match /waiting_pool/{userId} {
      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'waiting'
        && request.resource.data.mode in ['1v1', 'group']
        && request.resource.data.roomId == null
        && request.resource.data.keys().hasAll(['createdAt', 'status', 'mode', 'updatedAt', 'roomId']);

      // clients can only touch updatedAt — Cloud Functions set status/roomId
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // ── rooms ─────────────────────────────────────────────────────────────────
    // Cloud Functions are the sole writers except for the isLocked field on
    // custom rooms, which any current member may toggle directly.
    match /rooms/{roomId} {
      // Members read active/padding rooms; tombstones (status=='expired', users:[])
      // are readable by any signed-in user so clients can surface "expired" errors.
      allow read: if isSignedIn() && (
        resource.data.status == 'expired' ||
        request.auth.uid in resource.data.users
      );

      allow create, delete: if false;

      // Members may toggle isLocked on custom rooms only
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.users
        && resource.data.roomType == 'custom'
        && resource.data.status != 'expired'
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['isLocked']);
    }

    // ── active_sessions ──────────────────────────────────────────────────────
    // Legacy proto-session support — new sessions use rooms/{roomId}.
    match /active_sessions/{sessionId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow write: if false;
    }

    // ── reports ──────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
            'reporterId', 'reportedUserId', 'sessionId', 'reason',
            'description', 'chatLog', 'createdAt', 'status'
           ])
        && request.resource.data.keys().hasAll([
            'reporterId', 'reportedUserId', 'sessionId', 'reason',
            'chatLog', 'createdAt', 'status'
           ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ── session_keys ─────────────────────────────────────────────────────────
    // Written and read by Cloud Functions only via admin SDK — deny all client access.
    match /session_keys/{sessionId} {
      allow read, write: if false;
    }

    // ── chat_rooms/messages ───────────────────────────────────────────────────
    // Participant check spans both rooms (new) and active_sessions (legacy).
    match /chat_rooms/{sessionId}/messages/{messageId} {
      allow read: if isSignedIn() && isChatRoomParticipant(sessionId);

      allow create: if isSignedIn()
        && isChatRoomParticipant(sessionId)
        && request.resource.data.keys().hasAll([
            'senderId', 'displayName', 'encryptedText',
            'iv', 'authTag', 'timestamp', 'expiresAt', 'flagged'
           ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200
        && request.resource.data.encryptedText is string
        && request.resource.data.encryptedText.size() < 12000
        && request.resource.data.iv is string
        && request.resource.data.iv.size() <= 24
        && request.resource.data.authTag is string
        && request.resource.data.authTag.size() <= 32
        && request.resource.data.timestamp is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.flagged == false;

      allow update, delete: if false;
    }
  }
}
